operatorNamespace: {{ rook_ceph_namespace }}
clusterName: {{ rook_ceph_cluster_name }}
cephImage:
  repository: {{ rook_ceph_image_repository }}
  tag: {{ rook_ceph_image_tag }}

configOverride: |
  [global]
  osd_pool_default_pg_autoscale_mode = on
  osd_pool_default_size = {{ pool_size }}
  osd_pool_default_min_size = {{ min_size }}

cephClusterSpec:
  dataDirHostPath: "{{ rook_ceph_data_dir | default('/var/lib/rook') }}"
{% if (rook_ceph_render_daemon_security | default(false) | bool) or
      (rook_ceph_rotate_daemon_keys | default(false) | bool) %}
  # Rook 1.19.10/Ceph 19.2.6 closes CVE-2025-30156. Existing clusters
  # need one daemon-key rotation while Ceph is upgraded. Keep this stanza
  # on later reconciliations because the CRD makes keyGeneration non-removable.
  security:
    cephx:
      daemon:
        keyRotationPolicy: KeyGeneration
        keyGeneration: {{ rook_ceph_daemon_key_generation | default(2) }}
        keyType: aes256k
{% endif %}
  resources:
  mon:
    count: {{ mon_count }}
  mgr:
    count: {{ mgr_count }}

  storage:
    useAllNodes: false
    useAllDevices: false
    config:
      osdsPerDevice: "{{ osds_per_device }}"
    nodes:
{% for node in storage_nodes | default([]) %}
      - name: "{{ node.name }}"
        devices:
{% for device in node.devices %}
          - name: "{{ device.name }}"
{% endfor %}
{% endfor %}
cephBlockPools:
  - name: akash-deployments
    spec:
      failureDomain: {{ failure_domain }}
      replicated:
        size: {{ pool_size }}
      parameters:
        min_size: "{{ min_size }}"
        bulk: "true"
    storageClass:
      enabled: true
      name: {{ storage_class }}
      isDefault: true
      reclaimPolicy: Delete
      allowVolumeExpansion: true
      parameters:
        # RBD image format. Defaults to "2".
        imageFormat: "2"
        # RBD image features. Available for imageFormat: "2". CSI RBD currently supports only `layering` feature.
        imageFeatures: layering
        # The secrets contain Ceph admin credentials.
        csi.storage.k8s.io/provisioner-secret-name: rook-csi-rbd-provisioner
        csi.storage.k8s.io/provisioner-secret-namespace: {{ rook_ceph_namespace }}
        csi.storage.k8s.io/controller-expand-secret-name: rook-csi-rbd-provisioner
        csi.storage.k8s.io/controller-expand-secret-namespace: {{ rook_ceph_namespace }}
        csi.storage.k8s.io/node-stage-secret-name: rook-csi-rbd-node
        csi.storage.k8s.io/node-stage-secret-namespace: {{ rook_ceph_namespace }}
        # Specify the filesystem type of the volume. If not specified, csi-provisioner
        # will set default as `ext4`. Note that `xfs` is not recommended due to potential deadlock
        # in hyperconverged settings where the volume is mounted on the same node as the osds.
        csi.storage.k8s.io/fstype: ext4
# Do not create default Ceph file systems, object stores
cephFileSystems:
cephObjectStores:
# Spawn rook-ceph-tools, useful for troubleshooting
toolbox:
  enabled: true
  resources:
